{
  "name": "slightgrey/wp-activity-ledger",
  "description": "Records every meaningful action on a WordPress site, with field-level diffs, alerts, export and a React admin.",
  "version": "0.3.0",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/woocommerce-stubs": "^11.3",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "WPActivityLedger\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WPActivityLedger\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit --testsuite unit",
    "test:integration": [
      "Composer\\Config::disableProcessTimeout",
      "@php tests/Integration/run.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.1.31"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
